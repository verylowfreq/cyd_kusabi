# ESP-IDF
cyberdeck_firmware/build/
cyberdeck_firmware/managed_components/
cyberdeck_firmware/sdkconfig
cyberdeck_firmware/sdkconfig.old
# 最後にビルドした基板。cdk.py build --board が使う（作業状態であって仕様ではない）
cyberdeck_firmware/.cdk_board
# dependencies.lock は BSP のバージョンを固定するのでコミットする

# ホスト側ビルド
cyberdeck_firmware/build-host/

# 実行時に出る成果物
cyberdeck_firmware/*.png
cyberdeck_firmware/*.raw
cyberdeck_firmware/*.log

# 資格情報。ソースにも sdkconfig にも入れない (DESIGN.md 8.1)
cyberdeck_firmware/secrets.h
cyberdeck_firmware/main/secrets.h
cyberdeck_firmware/sdkconfig.local

# エディタ
.vscode/
__pycache__/

# ルート直下のログ
*.log

# Claude Code のローカル設定。settings.json（統計フック）だけは追跡する。
.claude/*
!.claude/settings.json

# 秘密情報
.env

# カメラ撮影
camera-*.jpg
cyberdeck_firmware/*.jpg

# 統計フックが貯める生カウンタ（DEV_STATS.md に集計する）
.dev-stats.json

# ユーザーアプリのビルド成果。
# host/fixtures/wasm/*.wasm は ctest が使うのでコミットする（ここでは無視しない）。
cyberdeck_firmware/wasm-apps/build/
