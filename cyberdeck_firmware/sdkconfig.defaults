# Cyberdeck ファームウェアの既定設定
# 試作機: M5Stack CoreS3 (ESP32-S3R8 / 16MB flash / 8MB octal PSRAM)

CONFIG_IDF_TARGET="esp32s3"

# --- フラッシュ ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- PSRAM ---
# キャンバス(最大300KB)、SKK 辞書索引、SSH のバッファをここに置く。
# CoreS3 の PSRAM は quad。octal にすると
# "PSRAM chip is not connected, or wrong PSRAM line mode" で起動時に abort する。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# --- CPU ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# --- コンソール（DESIGN.md §3.4） ---
# ログは UART1 → CoreS3 PORT.C (G17=TX / G18=RX) → FT232 (COM75)。
# USB-Serial-JTAG は cdk_proto の制御チャネル専用にするので、
# ログを一切流さないように SECONDARY_NONE にする。
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_NUM=1
CONFIG_ESP_CONSOLE_UART_TX_GPIO=17
CONFIG_ESP_CONSOLE_UART_RX_GPIO=18
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- ログ ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_TIMESTAMP_SOURCE_RTOS=y

# --- 起動を速くする（開発ループを短くするため） ---
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y

# --- スタック ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- FATFS / microSD（DESIGN.md §10） ---
# 既定は CONFIG_FATFS_LFN_NONE で、8.3 の短縮名しか扱えない。
# known_hosts は 11 文字なので fopen が FR_INVALID_NAME で失敗する。
# libssh2 からは rc=-16 (LIBSSH2_ERROR_FILE) としか見えず原因が分かりにくい。
# 症状の目印: ls にカードの実ファイルが LICENC~1.BRO のように出る。
# LFN は HEAP に置く。STACK だと 255*2 バイトが各タスクのスタックに乗る。
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
# ファイル名の API は UTF-8。端末も cdk_term も UTF-8 なので変換点を作らない。
CONFIG_FATFS_API_ENCODING_UTF_8=y
