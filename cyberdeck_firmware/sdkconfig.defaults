# Cyberdeck ファームウェアの既定設定（**基板に依らない部分だけ**）
#
# 基板ごとの違いは sdkconfig.defaults.cores3 / sdkconfig.defaults.v1 にある。
# PSRAM のモードやコンソールの出口が基板で違うので、混ぜると
# 起動時に abort する（CoreS3 に octal を指定すると必ず落ちる）。
#
#   python tools/cdk.py build              # 既定 = cores3
#   python tools/cdk.py build --board v1
#
# 手で叩くなら:
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.cores3" build

CONFIG_IDF_TARGET="esp32s3"

# --- フラッシュ ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- PSRAM ---
# キャンバス(最大300KB)、SKK 辞書索引、SSH のバッファをここに置く。
# **モード (quad / octal) は基板ごとの defaults で指定する。**
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# --- CPU ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# --- ログ ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_TIMESTAMP_SOURCE_RTOS=y

# --- 起動を速くする（開発ループを短くするため） ---
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y

# --- スタック ---
# **公開鍵認証を足したら 8192 では溢れた**（不具合 #40）。libssh2 が
# PEM を読んで EC の署名をするところがメインタスクの上で走るため。
# 症状は「SSH に入ろうとすると再起動」で、ログに
#   ***ERROR*** A stack overflow in task main has been detected.
# が出る。余裕は決め打ちにせず、接続後に実測して `info` に出している。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# --- FATFS / microSD（DESIGN.md §10） ---
# 既定は CONFIG_FATFS_LFN_NONE で、8.3 の短縮名しか扱えない。
# known_hosts は 11 文字なので fopen が FR_INVALID_NAME で失敗する。
# libssh2 からは rc=-16 (LIBSSH2_ERROR_FILE) としか見えず原因が分かりにくい。
# 症状の目印: ls にカードの実ファイルが LICENC~1.BRO のように出る。
# LFN は HEAP に置く。STACK だと 255*2 バイトが各タスクのスタックに乗る。
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
# ファイル名の API は UTF-8。端末も cdk_term も UTF-8 なので変換点を作らない。
CONFIG_FATFS_API_ENCODING_UTF_8=y

# --- TLS（DESIGN.md §15.7） ---
# ユーザーアプリの CDK_SOCK_TLS_INSECURE のために要る。
# esp-tls は CA を一切指定しない cfg を渡されたとき、既定では
# 「検証を飛ばす」のではなく setup ごと失敗する（esp_tls_mbedtls.c）。
# この 2 つを入れると、その場合の既定が MBEDTLS_SSL_VERIFY_NONE になる。
#
# **CDK_SOCK_TLS（既定の型）は常に crt_bundle_attach を渡すので、
# この既定には落ちない。** SSH は libssh2 が mbedtls を直接使う経路で、
# esp-tls を通らないので影響を受けない（実機で確認した）。
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

# --- mbedtls の確保先 ---
# **PSRAM に回す。** 既定 (INTERNAL) のままだと、TLS を 2 本開いた時点で
# 内部 DRAM が枯れて
#   E esp-aes: Failed to allocate memory
# が出る。しかも壊れるのは 2 本目だけではなく、**繋がっている 1 本目の
# 送受信まで巻き添えになる。** 4 本試したときは再起動した
# （rst:0xc、バックトレースは CORRUPTED）。
#
# esp-aes の DMA 記述子は MALLOC_CAP_DMA なので必ず内部 DRAM から取る
# （esp_aes_dma_core.c）。mbedtls の 16KB/4KB バッファを PSRAM へ追い出して
# 内部を空けてやると、その小さな確保が通るようになる。
#
# SSH も同じ mbedtls を使う。変えたら SSH のログインまで確認すること。
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
